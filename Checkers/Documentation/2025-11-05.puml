        - bgWidth: int
        - btnStartGame: Button
        - btnReplayGames: Button
        - btnExitGame: Button
        __
        + MainMenuScreen(screenChanger)
        + LoadContent(context)
        + UnloadContent()
        + Update(gameTime)
        + Draw(gameTime)
        - BtnStartGame_Clicked(sender, e)
        - BtnReplayGames_Clicked(sender, e)
        - BtnExitGame_Clicked(sender, e)
    }

    class GameScreen {
        - _screenChanger: IScreenChanger
        - _appContext: IAppContext?
        - _gameService: GameService?
        - isPieceSelected: bool
        - isWinner: bool
        - selectedPosition: Position
        - currentPlayer: Player?
        - validMoves: List<Position>
        - btnMainMenu: Button
        - btnStartGame: Button
        - btnUndoMove: Button
        - btnRestartGame: Button
        - btnEndTurn: Button
        - btnSaveGame: Button
        - btnVictory: Button
        - lblDescription: Label
        - lblRules: Label
        - lblCurrentPlayer: Label
        - lbVictory: Label
        - chkColorBlindMode: CheckBox
        __
        + GameScreen(screenChanger)
        + LoadContent(context)
        + UnloadContent()
        + Update(gameTime)
        + Draw(gameTime)
        - BtnMainMenu_Clicked(sender, e)
        - BtnStartGame_Clicked(sender, e)
        - BtnUndoMove_Clicked(sender, e)
        - BtnRestartGame_Clicked(sender, e)
        - BtnEndTurn_Clicked(sender, e)
        - BtnSaveGame_Clicked(sender, e)
        - BtnVictory_Clicked(sender, e)
        - ChangeColorBlindMode(sender, e)
    }

    class ReplayScreen {
        - _screenChanger: IScreenChanger
        - _appContext: IAppContext?
        - _replayService: ReplayService?
        - btnMainMenu: Button
        - btnAutoPlay: Button
        - btnReset: Button
        - btnNextMove: Button
        - btnPreviousMove: Button
        - cboGames: ComboBox
        - lblGames: Label
        - chkColorBlindMode: CheckBox
        - isAutoPlaying: bool
        __
        + ReplayScreen(screenChanger)
        + LoadContent(context)
        + UnloadContent()
        + Update(gameTime)
        + Draw(gameTime)
        - BtnMainMenu_Clicked(sender, e)
        - BtnNextMove_Clicked(sender, e)
        - BtnPreviousMove_Clicked(sender, e)
        - BtnReset_Clicked(sender, e)
        - btnAutoPlay_Clicked(sender, e)
        - CboGames_SelectedItemChanged(sender, e)
        - ChkColorBlindMode_CheckedChanged(sender, e)
    }

    enum ScreenID <<enumeration>> {
        MainMenu
        Game
        Replay
        Settings
        Restart
    }
}

