package "UI Layer - Screens" #F3E5F5 {
    interface IScreen {
        __
        + LoadContent(appContext)
        + UnloadContent()
        + Update(gameTime)
        + Draw(gameTime)
    }

    interface IScreenChanger {
        __
        + ChangeScreen(screenID)
    }

    interface IAppContext {
        + SpriteBatch: SpriteBatch
        + Content: ContentManager
        + GraphicsDevice: GraphicsDevice
    }

    class AppContext <<sealed>> {
        + SpriteBatch: SpriteBatch
        + Content: ContentManager
        + GraphicsDevice: GraphicsDevice
        __
        + AppContext(spriteBatch, content, graphics)
    }

    class ScreenManager <<sealed>> {
        - _appContext: IAppContext
        - _currentScreen: IScreen?
        - _screens: Dictionary<ScreenID, IScreen>
        + CurrentScreen: IScreen
        __
        + ScreenManager(context)
        + AddScreen(screenID, screen)
        + ChangeScreen(screenID)
        + Update(gameTime)
        + Draw(gameTime)
    }

    class MainMenuScreen {
        - _screenChanger: IScreenChanger
        - _appContext: IAppContext?
        - background: Texture2D?
